								"api",
								"emails",
								"send"
							]
						},
						"description": "Envia um email com anexos. Cada anexo tem 'filename', 'contentType' (opcional, padrão application/octet-stream) e 'base64Content' (conteúdo do arquivo em Base64). Limites: 5 anexos e 10 MB no total. O exemplo anexa um .txt com o texto 'Anexo de teste do Email Service'."
					},
