		{
			"name": "Exemplo completo",
			"item": [
				{
					"name": "Fluxo completo - Registrar, criar template e enviar",
					"item": [
						{
							"name": "1. Registrar usuário",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 201) {",
											"    pm.test('Registro bem-sucedido', function() {",
											"        var jsonData = pm.response.json();",
											"        pm.expect(jsonData.token).to.not.be.undefined;",
											"        pm.collectionVariables.set('token', jsonData.token);",
											"    });",
											"}"
										]
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"username\": \"usuario_teste\",\n    \"email\": \"usuario@teste.com\",\n    \"password\": \"senha12345\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{baseUrl}}/api/auth/register",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"auth",
										"register"
									]
								}
							},
							"response": []
						},
						{
							"name": "2. Criar template de pedido",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 201) {",
											"    var jsonData = pm.response.json();",
											"    pm.collectionVariables.set('templateId', jsonData.id);",
											"    pm.test('Template criado', function() {",
											"        pm.expect(jsonData.name).to.eql('confirmacao-pedido');",
											"    });",
											"}"
										]
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer {{token}}",
										"type": "text"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"confirmacao-pedido\",\n    \"subject\": \"Confirmação do Pedido #{{orderId}}\",\n    \"htmlContent\": \"<!DOCTYPE html>\\n<html xmlns:th=\\\"http://www.thymeleaf.org\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <style>\\n        body { font-family: Arial, sans-serif; }\\n        .container { max-width: 600px; margin: 0 auto; padding: 20px; }\\n        .header { background-color: #4CAF50; color: white; padding: 20px; text-align: center; }\\n        .content { padding: 20px; background-color: #f9f9f9; }\\n        .footer { padding: 10px; text-align: center; font-size: 12px; color: #666; }\\n    </style>\\n</head>\\n<body>\\n    <div class=\\\"container\\\">\\n        <div class=\\\"header\\\">\\n            <h1>Pedido Confirmado!</h1>\\n        </div>\\n        <div class=\\\"content\\\">\\n            <p>Olá <strong>[[${customerName}]]</strong>,</p>\\n            <p>Seu pedido <strong>#[[${orderId}]]</strong> foi confirmado com sucesso!</p>\\n            <hr>\\n            <h3>Detalhes:</h3>\\n            <ul>\\n                <li><strong>Data:</strong> [[${orderDate}]]</li>\\n                <li><strong>Valor:</strong> R$ [[${totalAmount}]]</li>\\n                <li><strong>Status:</strong> [[${status}]]</li>\\n            </ul>\\n            <p>\\n                <strong>Código de rastreamento:</strong> [[${trackingCode}]]\\n            </p>\\n        </div>\\n        <div class=\\\"footer\\\">\\n            <p>Obrigado por comprar conosco!</p>\\n        </div>\\n    </div>\\n</body>\\n</html>\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{baseUrl}}/api/templates",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"templates"
									]
								}
							},
							"response": []
						},
						{
							"name": "3. Enviar email de confirmação",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer {{token}}",
										"type": "text"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"templateId\": \"{{templateId}}\",\n    \"toEmail\": \"cliente@exemplo.com\",\n    \"variables\": {\n        \"customerName\": \"Maria Santos\",\n        \"orderId\": \"12345\",\n        \"orderDate\": \"17/04/2026\",\n        \"totalAmount\": \"199.90\",\n        \"status\": \"Confirmado\",\n        \"trackingCode\": \"TRK-987654321\"\n    }\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{baseUrl}}/api/emails/send",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"emails",
										"send"
									]
								}
							},
							"response": []
						},
						{
							"name": "4. Verificar status do email",
							"request": {
								"method": "GET",
								"header": [
									{
