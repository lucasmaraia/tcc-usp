							"mode": "raw",
							"raw": "{\n    \"templateId\": \"SUBSTITUIR_PELO_ID_DO_TEMPLATE\",\n    \"toEmail\": \"destinatario@example.com\",\n    \"variables\": {\n        \"name\": \"João Silva\",\n        \"email\": \"joao@exemplo.com\"\n    },\n    \"attachments\": [\n        {\n            \"filename\": \"anexo-teste.txt\",\n            \"contentType\": \"text/plain\",\n            \"base64Content\": \"QW5leG8gZGUgdGVzdGUgZG8gRW1haWwgU2VydmljZQ==\"\n        }\n    ]\n}",
							"options": {
